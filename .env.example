# Local Ollama: run Ollama on the SAME computer as npm start.
AI_MODE=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2
# API mode only: set AI_MODE=openai, your exact HTTPS /v1 endpoint and model.
# AI_API_KEY=
# Required when exposing a configured model remotely. Never use a provider key here.
# APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3000

# Explicit public Groq demo only, otherwise leave false.
PUBLIC_DEMO=false
